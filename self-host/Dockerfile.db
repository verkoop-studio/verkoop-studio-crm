# The Supabase Postgres image, plus the handful of things it does not do for
# itself. Railway builds this; the SQL runs once, on an empty volume.
#
# Paths are from the repository root, which is the build context both here and
# on Railway. Anything else means a service that builds on a laptop and not in
# production, or needs a root directory set by hand in a web form that nobody
# remembers setting.
FROM public.ecr.aws/supabase/postgres:17.11.0.018
COPY self-host/init/ /docker-entrypoint-initdb.d/

# Put the data one level inside the mount.
#
# A Railway volume arrives formatted, which means it already contains
# lost+found, which means it is not empty, which means initdb refuses to touch
# it: "directory exists but is not empty", on a loop, forever. The deploy
# reports success while the container restarts behind it.
#
# PGDATA one level down gives initdb the empty directory it insists on. It is
# set here rather than as a service variable because a variable is a thing
# somebody can forget when they stand the next one up.
ENV PGDATA=/var/lib/postgresql/data/pgdata
