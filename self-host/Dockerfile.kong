# The gateway, with its configuration baked in.
#
# Railway has no way to mount a single file into a container, and the config is
# not a secret — it is three routes and a comment about why there is no
# api-key plugin. Putting it in the image means the thing that runs is the
# thing in the repository.
FROM public.ecr.aws/supabase/kong:2.8.1
COPY self-host/kong.yml /home/kong/kong.yml
ENV KONG_DATABASE=off \
    KONG_DECLARATIVE_CONFIG=/home/kong/kong.yml \
    KONG_PLUGINS=request-transformer,cors \
    KONG_PROXY_LISTEN="0.0.0.0:8000, [::]:8000" \
    KONG_NGINX_PROXY_PROXY_BUFFER_SIZE=160k \
    KONG_NGINX_PROXY_PROXY_BUFFERS="64 160k"
# Railway's private network answers with AAAA records only. Kong's default
# resolution order tries A first and gives up, so every upstream looks down.
ENV KONG_DNS_ORDER=LAST,AAAA,A,CNAME
