# node self-host/keys.mjs prints the first block. Never commit a filled copy:
# self-host/.env is covered by the repository's .gitignore.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
STORAGE_DB_PASSWORD=
AUTHENTICATOR_DB_PASSWORD=

# The gateway's own address, with no path. GoTrue drops a path from this.
PUBLIC_API_URL=http://127.0.0.1:54331
GATEWAY_PORT=54331

# Where a link in an authentication mail is allowed to return to. A redirect
# that is not on the allow list is not refused, it is replaced by SITE_URL.
SITE_URL=http://127.0.0.1:5173
URI_ALLOW_LIST=http://127.0.0.1:5173/**,http://localhost:5173/**
MAILER_EXTERNAL_HOSTS=
MAILER_AUTOCONFIRM=false

# Locally these point at the mail catcher the compose file starts.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=account@send.verkoop.studio
SMTP_SENDER_NAME=Verkoop Studio Sales

# Must serve the five files from supabase/templates/ over HTTP.
TEMPLATE_BASE_URL=http://host.docker.internal:54399

# file keeps the signed contracts on one disk. Production uses s3.
STORAGE_BACKEND=file
S3_BUCKET=
