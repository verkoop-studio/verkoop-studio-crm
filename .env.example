# Set these only to the new independent CRM project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
CRM_PUBLIC_URL=
# Billing is a stub until this is set. src/lib/billing.ts is the only place
# that reads it and the only place to replace when real keys exist: with it
# empty, checkout collects the form, sends nothing to any payment provider,
# stores no card and says so on the screen. Leave it empty to keep that.
VITE_STRIPE_PUBLISHABLE_KEY=
# Server only. Use a sending-only key for the verified sender domain.
RESEND_API_KEY=
CRM_INVITATION_FROM=Sales CRM <uitnodigingen@send.verkoop.studio>
